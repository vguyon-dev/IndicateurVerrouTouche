<UserControl x:Class="IndicateurVerrouTouche.UI.Controls.SoundSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="8">
        <CheckBox Content="Activer le retour sonore" IsChecked="{Binding Actif}" Margin="0,0,0,8"/>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
            <TextBlock Text="Son ON (fichier/systeme)" Grid.Row="0"/>
            <DockPanel Grid.Row="0" Grid.Column="1">
                <Button Content="…" DockPanel.Dock="Right" Width="28" Tag="SonOn" Click="ChoisirSon"/>
                <TextBox Text="{Binding SonOn}"/>
            </DockPanel>
            <TextBlock Text="Son OFF (fichier/systeme)" Grid.Row="1"/>
            <DockPanel Grid.Row="1" Grid.Column="1">
                <Button Content="…" DockPanel.Dock="Right" Width="28" Tag="SonOff" Click="ChoisirSon"/>
                <TextBox Text="{Binding SonOff}"/>
            </DockPanel>
            <TextBlock Text="Volume (0-1)" Grid.Row="2"/><TextBox Text="{Binding Volume}" Grid.Row="2" Grid.Column="1"/>
        </Grid>
    </StackPanel>
</UserControl>
